{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    { "source": "/dossier/attrition", "destination": "/projects/employee-attrition-analysis", "permanent": true },
    { "source": "/employee-attrition", "destination": "/projects/employee-attrition-analysis", "permanent": true },
    { "source": "/map", "destination": "/experience", "permanent": true },
    { "source": "/dossiers", "destination": "/projects", "permanent": false },
    { "source": "/dossier/:id", "destination": "/projects", "permanent": false },
    { "source": "/datavista", "destination": "/projects/datavista", "permanent": true },
    { "source": "/neuroinsight-ai", "destination": "/projects/neuroinsight-ai", "permanent": true },
    { "source": "/kanbanlight", "destination": "/projects", "permanent": false },
    { "source": "/cropdoc-ai", "destination": "/", "permanent": false },
    { "source": "/api-ingestor", "destination": "/", "permanent": false },
    { "source": "/publications/surveillance", "destination": "/publications/v-surveillance", "permanent": true },
    { "source": "/publications/linker", "destination": "/publications", "permanent": false },
    { "source": "/publication", "destination": "/publications", "permanent": true },
    { "source": "/publication/surveillance", "destination": "/publications/v-surveillance", "permanent": true },
    { "source": "/publication/:id", "destination": "/publications", "permanent": false },
    { "source": "/telegram", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/200.html"
    }
  ]
}
